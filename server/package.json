{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate dev --schema=../prisma/schema.prisma",
    "generate": "prisma generate --schema=../prisma/schema.prisma",
    "seed": "ts-node ../prisma/seed.ts",
    "db:reset": "prisma migrate reset --schema=../prisma/schema.prisma",
    "seed:prod": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"target\":\"ES2020\",\"esModuleInterop\":true,\"ignoreDeprecations\":\"6.0\"}' ts-node --transpile-only --skip-project ../prisma/seedProd.ts"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma",
    "seed": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"target\":\"ES2020\",\"esModuleInterop\":true,\"ignoreDeprecations\":\"6.0\"}' ts-node --transpile-only --skip-project ../prisma/seed.ts"
  },
